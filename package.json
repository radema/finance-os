{
  "name": "gbi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "gbi": "dist/gbi.js"
  },
  "scripts": {
    "dev": "node tools/dev.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && vite build --ssr server/bin.ts",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "echarts": "6.1.0",
    "fast-check": "4.10.2",
    "kysely": "0.29.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
