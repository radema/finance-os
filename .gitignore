# Dependencies and install output
node_modules/
.pnpm-store/
.npm/
.yarn/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output and tool caches
dist/
build/
coverage/
*.tsbuildinfo
.vite/
.cache/
.swc/
.eslintcache

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Personal data - never committed. Only the repo-root fixtures/ folder may hold such files.
# The app data lives in GBI_DATA_DIR, outside the repo; these rules guard against a stray copy.
# The exceptions are written for files: a negation cannot re-include a file under an ignored folder.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
*.db-wal
*.db-shm
*-wal
*-shm
*.xlsx
*.csv
!/fixtures/**/*.sqlite
!/fixtures/**/*.db
!/fixtures/**/*.xlsx
!/fixtures/**/*.csv

# Agent worktrees and local agent settings
.claude/worktrees/
.claude/settings.local.json

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*:Zone.Identifier

# Prototype screenshots: regenerable, too large to commit
.scratch/gbi-v1/prototypes/*/screens/

# Prototype build output and local data
.scratch/gbi-v1/prototypes/*/node_modules/
.scratch/gbi-v1/prototypes/*/dist/
.scratch/gbi-v1/prototypes/*/.data/
