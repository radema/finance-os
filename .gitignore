# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# uv / venv
.venv/
venv/
uv.lock.bak

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# DuckDB / data
*.duckdb
*.duckdb.wal
data/
imports/
export/
exports/

# Real personal financial data — never committed, even the empty template once filled in.
# real/README.md stays tracked; every data file under real/ does not.
real/*.csv
real/*.yaml
real/*.yml
real/*.xlsx
real/*.xls

# Agent worktrees — transient checkouts, never part of the project.
# `.claude/skills/` IS tracked; only the worktree churn is excluded.
.claude/worktrees/

# Editors / OS
.DS_Store
.idea/
.vscode/
*:Zone.Identifier

# Prototype screenshots: regenerable, too large to commit
.scratch/gbi-v1/prototypes/*/screens/
